YUVATECH_ENV=production
YUVATECH_DB_PATH=traffic.db

# Separate credentials for least-privilege roles. Generate long random values.
YUVATECH_API_KEY=CHANGE_ME_OPERATOR_KEY
YUVATECH_ADMIN_API_KEY=CHANGE_ME_ADMIN_KEY
YUVATECH_REVIEWER_API_KEY=CHANGE_ME_REVIEWER_KEY
YUVATECH_INVESTIGATOR_API_KEY=CHANGE_ME_INVESTIGATOR_KEY
YUVATECH_AUDITOR_API_KEY=CHANGE_ME_AUDITOR_KEY

YUVATECH_NOTIFICATIONS_ENABLED=false
YUVATECH_AUTO_DOWNLOAD_MODELS=false
YUVATECH_CAMERA_RECONNECT=true
YUVATECH_CAMERA_RECONNECT_MAX_RETRIES=0
YUVATECH_CAMERA_RECONNECT_INITIAL_BACKOFF=1
YUVATECH_CAMERA_RECONNECT_MAX_BACKOFF=30

# Wawp REST API (SDK is optional). Current official text endpoint is used by default.
WAWP_INSTANCE_ID=
WAWP_ACCESS_TOKEN=
WAWP_SESSION=
WAWP_SEND_URL=https://api.wawp.net/v2/send/text

# Gmail SMTP / Google App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM=

EVIDENCE_DIR=evidence_output
PLATE_MODEL_PATH=models/plate_detector.pt
HELMET_MODEL_PATH=models/helmet_detector.pt
SEATBELT_MODEL_PATH=models/seatbelt_detector.pt
REID_MODEL_PATH=
